rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /favorites/{promptId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /recentlyViewed/{promptId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /following/{creatorId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /prompts/{promptId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      match /likesBy/{uid} {
        allow read: if true;
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
